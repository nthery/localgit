#!/usr/bin/env bash
# vim: ts=8 sts=4 sw=4 et ft=sh

# Copyright (c) 2016-2025, Nicolas Thery (nthery@gmail.com)
#
# Maintain local git branches over sources managed with another SCM.
# See https://github.com/nthery/localgit for details.

# Bail out early if a command exits abnormally.
set -e

progname=$(basename "$0")

commands=""

##############################################################################
# DEBUGGING
##############################################################################

# TODO: Disable when thoroughly tested.
debug=1

# Enable shell tracing if debug mode set.
tron()
{
    if (( debug > 0 )); then
        set -x
    fi
}

# Disable shell tracing if debug mode set.
troff()
{
    if (( debug > 0 )); then
        set +x
    fi
}

##############################################################################
# ERROR MANAGEMENT
##############################################################################

error()
{
    echo 1>&2 "$progname: $*"
    exit 1
}

usage()
{
    local code=0
    if [[ -n "$*" ]]; then
        echo -e 1>&2 "$progname: $*\n"
        code=1
    fi
    echo -e 1>&2 "usage: $progname cmd args\n"
    echo -e 1>&2 "The supported commands are:\n"
    echo -e 1>&2 "$commands"
    exit $code
}

##############################################################################
# HELPERS
##############################################################################

# Keep support for localgit repos created before renaming from master to main.
detect_main_branch()
{
    if git show-ref --verify --quiet refs/heads/master; then
        echo "master"
    elif git show-ref --verify --quiet refs/heads/main; then
        echo "main"
    else
        error "can not find main nor master branch"
    fi
}

expect_topic()
{
    if [[ "$(current_branch)" == "$main_branch" ]]; then
        error "should be in topic branch but in main"
    fi
}

expect_main()
{
    if [[ "$(current_branch)" != "$main_branch" ]]; then
        error "should be in main branch but in $(current_branch)"
    fi
}

current_branch()
{
    git rev-parse --abbrev-ref HEAD
}

# Print all files in repo.
all_files()
{
    git ls-tree --full-tree -r "$main_branch" | awk '{print $4}' | grep -vw .lg
}

# Print root of git repo.
git_root() {
    git rev-parse --show-toplevel
}

# Print the git directory to create for the repo named $1 given the value $2
# of the -d option, which wins over LG_GIT_DIR_PREFIX.  Print nothing for a
# .git directory in the workspace.  Throw on error.
git_dir_to_create()
{
    local -r name="$1"
    local -r git_dir_opt="$2"

    if [[ -n "$git_dir_opt" ]]; then
        echo "$git_dir_opt"
    elif [[ -n "$LG_GIT_DIR_PREFIX" ]]; then
        [[ -d "$LG_GIT_DIR_PREFIX" ]] || error "directory not found: $LG_GIT_DIR_PREFIX"
        echo "$LG_GIT_DIR_PREFIX/${name}.git"
    fi
}

# Create in the current directory an empty git repo whose initial branch is
# main.  Its git directory is $1, whose missing parents are created, or a .git
# directory in the workspace if $1 is empty.  Throw on error.
init_git_repo()
{
    local -r git_dir="$1"

    [[ ! -e .git ]] || error ".git already exists"

    if [[ -z "$git_dir" ]]; then
        git init --initial-branch=main
        return
    fi

    [[ ! -e "$git_dir" ]] || error "directory already exists: $git_dir"
    mkdir -p "$(dirname "$git_dir")"
    # This leaves in the workspace a .git file pointing to the git directory.
    git init --initial-branch=main --separate-git-dir "$git_dir"
    # Let git commands given only the git directory find the workspace.
    git config core.worktree "$(pwd)"
}

# macOS does not have realpath(1) so emulate it.
# Pinched from https://stackoverflow.com/questions/3572030/bash-script-absolute-path-with-os-x
portable_realpath()
{
    local -r path="$1"

    local -r saved_cwd="$(pwd)"

    cd "$(dirname "$path")"
    local link
    link=$(readlink "$(basename "$path")")
    while [[ -n "$link" ]]; do
        cd "$(dirname "$link")"
        link=$(readlink "$(basename "$link")")
    done
    local -r real="$(pwd)/$(basename "$path")"
    cd "$saved_cwd"
    echo "$real"
}

xrealpath()
{
    local -r path="$1"

    if type realpath >/dev/null 2>&1; then
        realpath "$path"
    else
        portable_realpath "$path"
    fi
}

parent_dir()
{
    basename "$(pwd)"
}

##############################################################################
# init command
##############################################################################

commands="${commands}init [-n name | -d gitdir] - create local git\n"

lg_init()
{
    local opt
    local name=""
    local git_dir_opt=""
    while getopts ":n:d:" opt; do
        case $opt in
            n) name="$OPTARG" ;;
            d) git_dir_opt="$OPTARG" ;;
            :) error "option $OPTARG: missing argument" ;;
            *) error "bad option: $OPTARG" ;;
        esac
    done

    shift $(( OPTIND - 1 ))

    [[ -z "$name" || -z "$git_dir_opt" ]] || error "options -n and -d are mutually exclusive"
    [[ -n "$name" ]] || name="$(parent_dir)"

    local git_dir
    git_dir="$(git_dir_to_create "$name" "$git_dir_opt")"

    tron

    init_git_repo "$git_dir"

    # Create dummy initial commit.
    # Failing this initial lg-import from orphan topic branch fails.
    git commit --allow-empty -m 'lg: big bang'

    # Switch to topic branch.
    git checkout -b dev
}

##############################################################################
# import command
##############################################################################

commands="${commands}import - add file to local git\n"

lg_import()
{
    local rebase_all=0
    local opt
    while getopts ":ra" opt; do
        case $opt in
            a) rebase_all=1 ;;
            :) error "option $OPTARG: missing argument" ;;
            *) error "bad option: $OPTARG" ;;
        esac
    done
    
    shift $(( OPTIND - 1 ))

    (( $# > 0 )) || error "usage: import [-a] <file>..."

    local root
    root="$(git_root)"

    create_tmp_dir
    local -r list="$tmp_dir/list"
    repo_relative_paths "$root" "$@" > "$list"
    sort_paths "$list"

    import_listed_files "$list" "$rebase_all"
}

# Create temporary directory removed on exit and store its path in global
# tmp_dir.
create_tmp_dir()
{
    tmp_dir="$(mktemp -d)" || error "cannot create temporary directory"
    # We want to expand now rather than at exit-time as exit could be called from caller.
    # shellcheck disable=SC2064
    trap "rm -rf '$tmp_dir'" EXIT
}

# Sort in place file of paths $1 and remove duplicates.  The collation suits
# comm(1).
sort_paths()
{
    LC_ALL=C sort -u -o "$1" "$1"
}

# Print paths of files given as arguments relative to repo root $1.  Error out
# if a file is missing or not under the repo root.
repo_relative_paths()
{
    local -r root="$1"
    shift

    local f dir rel
    local prev_dir="" real_dir=""
    for f in "$@"; do
        [[ -f "$f" ]] || error "missing file: $f"

        # Resolve only the directory so that symbolic links are imported as is.
        if [[ "$f" == */* ]]; then
            dir="${f%/*}"
            dir="${dir:-/}"
        else
            dir=.
        fi

        # Consecutive files are often in the same directory.
        if [[ "$dir" != "$prev_dir" ]]; then
            real_dir="$(CDPATH='' cd -- "$dir" && pwd -P)"
            prev_dir="$dir"
        fi

        [[ "$real_dir/" == "$root"/* ]] || error "file not under repo root: $f"
        rel="${real_dir#"$root"}"
        rel="${rel#/}"
        echo "${rel:+$rel/}${f##*/}"
    done
}

# Convert absolute paths read from stdin into paths relative to repo root $1.
# Error out if a path is not under the repo root.
strip_repo_root()
{
    LG_ROOT="$1/" LG_PROGNAME="$progname" awk '
        index($0, ENVIRON["LG_ROOT"]) == 1 {
            print substr($0, length(ENVIRON["LG_ROOT"]) + 1)
            next
        }
        {
            print ENVIRON["LG_PROGNAME"] ": file not under repo root: " $0 > "/dev/stderr"
            exit 1
        }'
}

# Print sorted paths of files in main branch.
main_branch_paths()
{
    # ls-tree -r lists files in the tree of a commit.  -z disables quoting of
    # unusual (e.g. non-ASCII) names.
    git ls-tree -r -z --full-tree --name-only "$main_branch" | tr '\0' '\n' | LC_ALL=C sort
}

# Print sorted paths of files in index.
index_paths()
{
    # ls-files lists index entries under the current directory only, hence -C.
    git -C "$(git_root)" ls-files -z | tr '\0' '\n' | LC_ALL=C sort
}

# Error out if some files listed in $1 are missing or already in main or topic
# branch.
check_importable()
{
    local -r list="$1"

    local -r root="$(git_root)"
    local f
    while IFS= read -r f; do
        [[ -f "$root/$f" ]] || error "missing file: $f"
    done < "$list"

    f="$(LC_ALL=C comm -12 "$list" <(main_branch_paths) | head -n 1)"
    [[ -z "$f" ]] || error "file already baselined: $f"

    f="$(LC_ALL=C comm -12 "$list" <(index_paths) | head -n 1)"
    [[ -z "$f" ]] || error "file already committed on topic branch: $f"
}

# Error out if git replay cannot rebase onto main branch the branches named on
# stdin once files listed in $1 are imported.  As imported files are absent
# from these branches, this happens only when a branch has merge commits,
# which git replay does not support, or when a commit of a branch touches an
# imported file.
check_replayable()
{
    local -r list="$1"

    local branch range merge f
    while IFS= read -r branch; do
        range="refs/heads/$main_branch..refs/heads/$branch"

        # --min-parents=2 selects merge commits.
        merge="$(git rev-list --min-parents=2 -n 1 "$range")"
        if [[ -n "$merge" ]]; then
            error "cannot import: branch $branch has merge commit" \
                "$(git log -n 1 --format='%h (%s)' "$merge"), which git replay" \
                "cannot rebase; flatten it first, e.g. with 'git rebase $main_branch'"
        fi

        # --name-only lists paths touched by each commit.  --no-renames counts
        # a rename as touching both names.
        f="$(LC_ALL=C comm -12 "$list" \
            <(git log --no-renames --format= --name-only -z "$range" | tr '\0' '\n' | LC_ALL=C sort -u) |
            head -n 1)"
        if [[ -n "$f" ]]; then
            error "cannot import $f: commit" \
                "$(git --literal-pathspecs log -n 1 --format='%h (%s)' "$range" -- "$f")" \
                "on branch $branch touches it"
        fi
    done
}

# Print commit log for importing files listed in $1.  It fits in 80 columns.
import_log()
{
    local -r list="$1"

    local -r max=$(( 80 - 3 ))
    local log="lg: import"
    local f
    while IFS= read -r f && (( ${#log} <= max )); do
        log="$log $f"
    done < "$list"

    # If too long, first strip directories.
    if (( ${#log} > max )); then
        log="lg: import"
        while IFS= read -r f && (( ${#log} <= max )); do
            log="$log ${f##*/}"
        done < "$list"
    fi

    # If still too long, truncate.
    if (( ${#log} > max )); then
        log="${log:0:76}..."
    fi

    echo "$log"
}

# Add files listed in $1 to the index, whatever the ignore rules.  The index
# is the one selected by GIT_INDEX_FILE if set.
add_listed_files()
{
    # update-index --add stores the contents of the files as blobs in the object
    # database and records them in the index.  Unlike git add, it does not
    # match paths as pathspecs, which is much faster with many files.
    tr '\n' '\0' < "$1" | git -C "$(git_root)" update-index --add -z --stdin
}

# Commit files listed in $1 into main branch with log $2, leaving HEAD, index
# and working tree untouched.
commit_to_main()
{
    local -r list="$1"
    local -r log="$2"

    # Build the new tree in a scratch index initialized from main (read-tree).
    local -r index="$tmp_dir/index"
    GIT_INDEX_FILE="$index" git read-tree "$main_branch"
    GIT_INDEX_FILE="$index" add_listed_files "$list"

    local tree commit
    # write-tree stores the scratch index as a tree object and prints its id.
    tree="$(GIT_INDEX_FILE="$index" git write-tree)"
    # commit-tree creates a commit of this tree on top of main without moving
    # any branch.
    commit="$(git commit-tree "$tree" -p "$main_branch" -m "$log")"
    # Move main to the new commit, failing if main moved in the meantime
    # (the last argument is the expected current value).
    git update-ref "refs/heads/$main_branch" "$commit" "$(git rev-parse "$main_branch")"
}

# Print names of branches to rebase onto main branch: all of them if $1 is 1,
# the current one otherwise.
branches_to_rebase()
{
    if (( $1 )); then
        # for-each-ref lists local branches.  lstrip=2 drops "refs/heads/".
        git for-each-ref --format='%(refname:lstrip=2)' refs/heads/ | grep -vxF "$main_branch"
    else
        current_branch
    fi
}

# Rebase branches named on stdin onto main branch without touching index nor
# working tree.  Either all branches are rebased or none.  Return non-zero on
# failure.
replay_onto_main()
{
    local -r main_ref="refs/heads/$main_branch"

    # Collect "update <ref> <new commit> <expected old commit>" commands.
    local branch ref updates="" update
    while IFS= read -r branch; do
        ref="refs/heads/$branch"
        # rev-list main..branch lists commits on branch that are not in main.
        if [[ -z "$(git rev-list -n 1 "$main_ref..$ref")" ]]; then
            # Nothing to replay so fast-forward to main.  git replay rejects
            # empty ranges.  rev-parse prints the commit a ref points to.
            update="update $ref $(git rev-parse "$main_ref") $(git rev-parse "$ref")"
        # replay recreates commits main..branch on top of main and prints the
        # update command for branch, without touching any ref, HEAD, index or
        # working tree.
        elif ! update="$(git replay --onto "$main_ref" "$main_ref..$ref")"; then
            echo 1>&2 "$progname: cannot rebase $branch onto $main_branch"
            return 1
        fi
        updates="$updates$update"$'\n'
    done

    # update-ref --stdin applies all updates in a single transaction: if one
    # fails (e.g. a branch moved in the meantime), no branch moves.
    printf '%s' "$updates" | git update-ref --stdin
}

# Make owner-writable files listed in $1, leaving their modification time
# untouched.
make_writable()
{
    tr '\n' '\0' < "$1" | (cd "$(git_root)" && xargs -0 chmod u+w --)
}

# Commit files listed in $1 into main branch and rebase onto it the current
# branch, or all branches if $2 is 1.  Neither changes in index and working
# tree nor contents and modification time of imported files are touched.
# The list holds paths relative to repo root sorted with sort_paths.
import_listed_files()
{
    local -r list="$1"
    local -r rebase_all="$2"

    check_importable "$list"
    expect_topic
    check_replayable "$list" < <(branches_to_rebase "$rebase_all")

    local -r log="$(import_log "$list")"
    local -r old_main="$(git rev-parse "$main_branch")"

    tron

    commit_to_main "$list" "$log"

    if ! replay_onto_main < <(branches_to_rebase "$rebase_all"); then
        # No branch moved so moving main back undoes the import.  The new
        # commit becomes unreachable and is eventually garbage collected.
        git update-ref "refs/heads/$main_branch" "$old_main"
        error "import undone"
    fi

    # HEAD moved to a commit containing the imported files.
    add_listed_files "$list"

    make_writable "$list"
}

##############################################################################
# sync command
##############################################################################

commands="${commands}sync - rebase local main branch after sync'ing from remote SCM\n"

lg_sync()
{
    expect_main

    local msg="lg: sync"
    if [[ -n "$*" ]]; then
        msg="$msg: $*"
    fi

    tron

    # Stage changes and deletions of all tracked files, whatever the current
    # directory.  Unlike passing all files as arguments, this works with any
    # number of files and any file name.
    git add -u

    git commit -m "$msg"
}

##############################################################################
# status command
##############################################################################

commands="${commands}status - print status of files in local branches\n"

lg_status()
{
    git status -uno
}

##############################################################################
# log command
##############################################################################

commands="${commands}log - run git log on local topic branch excluding local main\n"

lg_log()
{
    expect_topic
    git log "$main_branch..$*"
}

##############################################################################
# files command
##############################################################################

commands="${commands}files - print files in local topic branch\n"

lg_files()
{
    expect_topic
    local rev="$*"
    if [[ -z "$rev" ]]; then
        rev="$main_branch...HEAD"
    fi

    git diff "$rev" | awk '
        function flush(action) { if (file != "") { print action, file; file = "" } }
        /^diff/ { flush("edit"); file = substr($3, 3) }
        /^new file/ { flush("add") }
        /^deleted file/ { flush("delete") }
        END { flush("edit") }
        '
}

##############################################################################
# clone command
##############################################################################

commands="${commands}clone - clone local git repo into another existing source tree\n"

# Validate user-provided source git directory and follow link if .git file provided.
src_git_dir()
{
    local src="$1"
    [[ -n "$src" ]] || error "missing source repo"
    if [[ -f "$src" ]]; then
        local -r remote_dir="$(awk '/^gitdir:/ { print $2 }' "$src")"
        [[ -n "$remote_dir" ]] || error "no gitdir in $src file"
        src="$remote_dir"
    fi
    [[ -d "$src" ]] || error "source git repo does not exist: $src"
    echo "$src"
}

lg_clone()
{
    local opt
    local name
    name="$(parent_dir)"
    while getopts ":n:" opt; do
        case $opt in
            n) name="$OPTARG" ;;
            :) error "option $OPTARG: missing argument" ;;
            *) error "bad option: $OPTARG" ;;
        esac
    done

    shift $(( OPTIND - 1 ))

    local src
    src="$(src_git_dir "$1")"

    local git_dir
    git_dir="$(git_dir_to_create "$name" "")"

    tron

    init_git_repo "$git_dir"

    git remote add origin "$src"
    git fetch

    # Sync local main branch with remote one leaving local changes unmodified.
    git reset "origin/main"
}

##############################################################################
# apply command
##############################################################################

commands="${commands}apply - apply a patch, importing files as needed\n"

lg_apply()
{
    expect_topic

    (( $# > 0 )) || error "usage: apply [git-apply-options...] <patch-file>"

    # Last argument is the patch file; everything else is forwarded to git apply.
    local -r patch="${!#}"
    local -a apply_opts=("${@:1:$#-1}")

    [[ -f "$patch" ]] || error "patch file not found: $patch"

    # Resolve patch path to absolute before changing to repo root, so that
    # relative paths still work.
    local -r abs_patch="$(xrealpath "$patch")"

    # Work from the repo root so that repo-relative paths parsed from the
    # patch resolve correctly even when invoked from a subdirectory.
    cd "$(git_root)"

    # Parse patch to determine which files need importing.
    local -a files_to_import=()
    local file="" kind=""

    # If current file needs importing, add it to files_to_import.
    flush_file_entry()
    {
        if [[ -n "$file" && "$kind" != "new" ]]; then
            if ! all_files | grep -qw "$file"; then
                [[ -f "$file" ]] || error "file not found in workspace: $file"
                files_to_import+=("$file")
            fi
        fi
    }

    while IFS= read -r line; do
        case "$line" in
            "diff --git "*)
                flush_file_entry
                file="${line#diff --git a/}"
                file="${file%% b/*}"
                kind="edit"
                ;;
            "new file mode"*)
                kind="new"
                ;;
            "deleted file mode"*)
                kind="delete"
                ;;
            "rename from "*)
                file="${line#rename from }"
                kind="rename"
                ;;
        esac
    done < "$abs_patch"

    flush_file_entry

    # De-duplicate.
    local -a unique_files=()
    if (( ${#files_to_import[@]} > 0 )); then
        while IFS= read -r f; do
            unique_files+=("$f")
        done < <(printf '%s\n' "${files_to_import[@]}" | sort -u)
    fi

    # Import files that are not yet tracked.
    if (( ${#unique_files[@]} > 0 )); then
        lg_import "${unique_files[@]}"
    fi

    # Apply the patch.
    git apply "${apply_opts[@]}" "$abs_patch"
}

##############################################################################
# cherry-pick command
##############################################################################

commands="${commands}cherry-pick - cherry-pick commits, importing files as needed\n"

cherry_pick_import_files()
{
    local -a files_to_import=()
    local tracked_files
    tracked_files=$(all_files || true)

    # shellcheck disable=SC2034
    while IFS=$'\t' read -r status old_file new_file; do
        [[ -n "$status" ]] || continue
        # git outputs status as A, R100, M, etc. (with similarity score for renames).
        case "$status" in
            A*)  ;;  # Added: new file, no import needed
            R*)      # Renamed: import the old name
                if ! echo "$tracked_files" | grep -qFx "$old_file"; then
                    [[ -f "$old_file" ]] && files_to_import+=("$old_file")
                fi
                ;;
            *)
                if ! echo "$tracked_files" | grep -qFx "$old_file"; then
                    [[ -f "$old_file" ]] && files_to_import+=("$old_file")
                fi
                ;;
        esac
    done < <(git log --name-status --pretty=format:'' "$@" --)

    # De-duplicate.
    local -a unique_files=()
    if (( ${#files_to_import[@]} > 0 )); then
        while IFS= read -r f; do
            unique_files+=("$f")
        done < <(printf '%s\n' "${files_to_import[@]}" | sort -u)
    fi

    if (( ${#unique_files[@]} > 0 )); then
        OPTIND=1
        lg_import "${unique_files[@]}"
    fi
}

lg_cherry_pick()
{
    expect_topic

    (( $# > 0 )) || error "usage: cherry-pick [git-cherry-pick-options...] <commit>..."

    cd "$(git_root)"

    # Save original args to pass verbatim to git cherry-pick.
    local -a all_args=("$@")

    # Separate options from commit specs.
    local -a commit_specs=()
    local end_of_opts=0

    while (( $# > 0 )); do
        if (( end_of_opts )); then
            commit_specs+=("$1")
            shift
            continue
        fi
        case "$1" in
            --)
                end_of_opts=1
                shift
                ;;
            --continue|--skip|--abort|--quit)
                git cherry-pick "${all_args[@]}"
                return
                ;;
            -m|--mainline|--strategy|-X|--strategy-option)
                shift 2
                ;;
            -*)
                shift
                ;;
            *)
                commit_specs+=("$1")
                shift
                ;;
        esac
    done

    if (( ${#commit_specs[@]} == 0 )); then
        git cherry-pick "${all_args[@]}"
        return
    fi

    cherry_pick_import_files "${commit_specs[@]}"

    tron

    git cherry-pick "${all_args[@]}"
}

##############################################################################
# p4 command and subcommands
##############################################################################

# LG_P4_CMD is used to mock p4 binary for testing.
p4_cmd="${LG_P4_CMD:-p4}"

p4_root()
{
    type "$p4_cmd" >/dev/null 2>&1 || error "cannot find p4 executable in path"

    local root
    root="$($p4_cmd info | sed -n 's/^Client root: //p')"
    [[ -n "$root" ]] || error "cannot find p4 client root"

    echo "$root"
}

resolve_export_range()
{
    if [[ -n "${1:-}" ]]; then
        if [[ "$1" == *..* ]]; then
            local left="${1%..*}"
            local right="${1#*..}"
            git rev-parse --verify "$left^{commit}" > /dev/null 2>&1 \
                || error "not a valid commit: $left"
            git rev-parse --verify "$right^{commit}" > /dev/null 2>&1 \
                || error "not a valid commit: $right"
            echo "$1"
        else
            git rev-parse --verify "$1^{commit}" > /dev/null 2>&1 \
                || error "not a valid commit: $1"
            echo "$1~1..$1"
        fi
    else
        echo "$main_branch..HEAD"
    fi
}

emit_p4_export_commands()
{
    expect_topic

    local -r range="$1"

    git diff --find-renames "$range" | awk '
        function flush() { if (from != "") { print "edit", from; from = to = "" } }
        /^diff/ { flush(); from = substr($3, 3); to = substr($4, 3) }
        /^new file/ { print("add", from); from = to = "" }
        /^deleted file/ { print("delete", from); from = to = "" }
        /^rename from/ { print("edit -k", from); print("move -k", from, to); from = to = "" }
        END { flush() }
        '
}

escape_p4_path()
{
    sed 's/@/%40/'
}

commands="${commands}p4 export - reflect all changes in topic branch into default changelist\n"

lg_p4_export()
{
    pushd "$(p4_root)"

    local opt
    revert=0
    while getopts ":r" opt; do
        case $opt in
            r) revert=1 ;;
            :) error "option $OPTARG: missing argument" ;;
            *) error "bad option: $OPTARG" ;;
        esac
    done
    shift $(( OPTIND - 1 ))

    # If requested, reset perforce state but keep all files as-is on disk.
    # This way this command can be run several times without weird effects.
    if (( revert )); then
        $p4_cmd revert -k ...
    fi

    # Accumulate failed commands into temporary file.
    local failed_commands
    failed_commands="$(mktemp)" || error "cannot create temporary file"
    # We want to expand now rather than at exit-time as exit could be called from caller.
    # shellcheck disable=SC2064
    trap "rm -f '$failed_commands'" EXIT

    local range
    range="$(resolve_export_range "${1:-}")"

    emit_p4_export_commands "$range" | escape_p4_path | while read -r cmd
    do
        # Do not error out as some errors are harmless.
        # When calling repeatedly this command and some files were moved, the corresponding
        # p4 commands fail after the first time because the sources do not exist anymore.
        set +e
        # Intentionally not quoting variable on next line to pass several arguments to p4.
        # shellcheck disable=SC2086
        if ! $p4_cmd $cmd; then
            echo "$p4_cmd $cmd" >> "$failed_commands"
        fi
        set -e
    done

    if [[ -s "$failed_commands" ]]; then
        echo 1>&2 "WARNING: some p4 commands failed:"
        cat 1>&2 "$failed_commands"
        exit 1
    fi

    popd
}

commands="${commands}p4 dry-export - display p4 commands that would be executed by p4 export\n"

lg_p4_dry_export()
{
    local range
    range="$(resolve_export_range "${1:-}")"

    emit_p4_export_commands "$range" | while read -r cmd
    do
        # Intentionally not quoting variable on next line to pass several arguments to p4.
        # shellcheck disable=SC2086
        echo p4 $cmd
    done
}

commands="${commands}p4 import  - import all p4 files under directories into local git\n"

lg_p4_import()
{
    local rebase_all=0
    local opt
    OPTIND=1
    while getopts ":a" opt; do
        case $opt in
            a) rebase_all=1 ;;
            :) error "option $OPTARG: missing argument" ;;
            *) error "bad option: $OPTARG" ;;
        esac
    done
    shift $(( OPTIND - 1 ))

    (( $# >= 1 )) || error "usage: p4 import [-a] <directory>..."
    local dir
    for dir in "$@"; do
        [[ -d "$dir" ]] || error "directory not found: $dir"
    done

    local root
    root="$(git_root)"

    create_tmp_dir
    local -r synced="$tmp_dir/synced"
    local -r list="$tmp_dir/list"

    # p4 have output format: //depot/path/file#rev - /local/path/file
    # Depot paths cannot contain '#' so the first one separates them from revisions.
    for dir in "$@"; do
        # p4 fails when there is no synced file.
        $p4_cmd have "$(xrealpath "$dir")/..." 2>/dev/null || true
    done | sed -n 's/^[^#]*#[0-9]* - //p' | strip_repo_root "$root" > "$synced"
    sort_paths "$synced"

    if [[ ! -s "$synced" ]]; then
        echo "no files synced under specified directories"
        return 0
    fi

    LC_ALL=C comm -23 "$synced" <(main_branch_paths) > "$list"

    if [[ ! -s "$list" ]]; then
        echo "all files already imported"
        return 0
    fi

    import_listed_files "$list" "$rebase_all"
}

commands="${commands}p4 reconcile - import p4 file edited before being imported, keeping local edits uncommitted\n"

# Import into local git the p4 baseline of a file that was edited before being
# imported and then put back the edited version in the workspace.
lg_p4_reconcile()
{
    (( $# == 1 )) || error "usage: p4 reconcile <file>"
    local -r file="$1"

    [[ -f "$file" ]] || error "missing file: $file"
    if git ls-files -- "$file" | grep -q .; then
        error "file already in local git: $file"
    fi
    expect_topic

    local -r p4_file="$(echo "$file" | escape_p4_path)"
    # Synced files are listed as depot paths.  Anything else is an error
    # message worth showing.
    local have_output
    set +e
    have_output=$($p4_cmd have "$p4_file" 2>&1)
    set -e
    [[ "$have_output" == //* ]] || error "file not synced from p4: $file: $have_output"

    # p4 sync -f does not overwrite opened files.  Opened files are listed as
    # depot paths whereas unopened ones trigger a "not opened" message.
    local opened_output
    set +e
    opened_output=$($p4_cmd opened "$p4_file" 2>/dev/null)
    set -e
    [[ "$opened_output" != //* ]] || error "file opened in p4: $file"

    # Keep backup next to file so that it is easy to find if something fails.
    local backup
    backup="$(mktemp "$file.lg-backup.XXXXXX")" || error "cannot create backup file"
    cp -p "$file" "$backup"
    echo "backed up $file to $backup"

    tron

    $p4_cmd sync -f "$p4_file#have"

    OPTIND=1
    lg_import "$file"

    # Move rather than copy as p4 may have made the file read-only.
    mv -f "$backup" "$file"
}

lg_p4()
{
    local -r subcmd="$1"
    case "$subcmd" in
        dry-export)
            shift 1
            lg_p4_dry_export "$@" ;;
        export)
            shift 1
            lg_p4_export "$@" ;;
        import)
            shift 1
            lg_p4_import "$@" ;;
        reconcile)
            shift 1
            lg_p4_reconcile "$@" ;;
        *)
            error "unknown or missing subcommand" ;;
    esac
}

##############################################################################
# completion command
##############################################################################

commands="${commands}completion - print bash completion script, use with: eval \"\$(lg completion)\"\n"

# Complete git ref, or right-hand side of ref range (A..B or A...B), matching
# prefix $1 into COMPREPLY.
_lg_complete_refs()
{
    local -r cur="$1"
    local range_prefix=""
    local ref="$cur"
    if [[ "$cur" == *..* ]]; then
        range_prefix="${cur%..*}.."
        ref="${cur##*..}"
    fi
    local refs
    refs="$(git for-each-ref --format='%(refname:short)' 2>/dev/null)"
    mapfile -t COMPREPLY < <(compgen -P "$range_prefix" -W "HEAD $refs" -- "$ref")
}

# Complete file names (or directory names only if $1 is -d) matching prefix $2
# into COMPREPLY.
_lg_complete_files()
{
    local -r kind="$1"
    local -r cur="$2"
    # compopt fails when not called from completion (e.g. from tests).
    compopt -o filenames 2>/dev/null || true
    mapfile -t COMPREPLY < <(compgen "$kind" -- "$cur")
}

# Bash completion function for lg.  It is printed by lg_completion so it must
# only call functions printed alongside.
_lg()
{
    local -r cur="${COMP_WORDS[COMP_CWORD]}"
    local -r prev="${COMP_WORDS[COMP_CWORD-1]}"
    COMPREPLY=()

    if (( COMP_CWORD == 1 )); then
        mapfile -t COMPREPLY < <(compgen -W "init import i sync status s files f log clone apply a cherry-pick cp p4 help completion" -- "$cur")
        return
    fi

    local cmd="${COMP_WORDS[1]}"
    if [[ "$cmd" == p4 ]]; then
        if (( COMP_CWORD == 2 )); then
            mapfile -t COMPREPLY < <(compgen -W "export dry-export import reconcile" -- "$cur")
            return
        fi
        cmd="p4 ${COMP_WORDS[2]}"
    fi

    # Options are offered only when explicitly started with a dash.
    local options=""
    case "$cmd" in
        init)               options="-n -d" ;;
        clone)              options="-n" ;;
        import|i)           options="-a" ;;
        cherry-pick|cp)     options="--continue --skip --abort --quit -m --mainline -X --strategy-option --strategy -n -x" ;;
        "p4 export")        options="-r" ;;
        "p4 import")        options="-a" ;;
    esac
    if [[ "$cur" == -* ]]; then
        mapfile -t COMPREPLY < <(compgen -W "$options" -- "$cur")
        return
    fi

    case "$cmd" in
        init)
            [[ "$prev" != -d ]] || _lg_complete_files -d "$cur" ;;
        clone)
            [[ "$prev" == -n ]] || _lg_complete_files -f "$cur" ;;
        import|i|apply|a|"p4 reconcile")
            _lg_complete_files -f "$cur" ;;
        "p4 import")
            _lg_complete_files -d "$cur" ;;
        log|files|cherry-pick|cp|"p4 export"|"p4 dry-export")
            _lg_complete_refs "$cur" ;;
    esac
}

lg_completion()
{
    declare -f _lg _lg_complete_refs _lg_complete_files
    echo "complete -F _lg lg localgit"
}

##############################################################################
# MAIN PROGRAM
##############################################################################

(( $# > 0 )) || usage "missing command"

cmd=$1
shift

case "$cmd" in
    init|help|clone|completion)
        # For commands that do not assume an existing repo, force main branch
        # name.
        main_branch="main" ;;
    *)
        # For other commands use existing main branch name.
        main_branch=$(detect_main_branch) ;;
esac

case "$cmd" in
    init)       lg_init "$@" ;;
    i|import)   lg_import "$@" ;;
    sync)       lg_sync "$@" ;;
    s|status)   lg_status "$@" ;;
    f|files)    lg_files "$@" ;;
    log)        lg_log "$@" ;;
    clone)      lg_clone "$@" ;;
    a|apply)    lg_apply "$@" ;;
    cp|cherry-pick) lg_cherry_pick "$@" ;;
    p4)         lg_p4 "$@" ;;
    completion) lg_completion ;;
    help)       usage ;;
    *)          usage "unknown command: $cmd" ;;
esac
